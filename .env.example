# Environment Variables — Copy to .env and fill in values
POSTGRES_USER=neuralchain
POSTGRES_PASSWORD=neuralchain_secret
POSTGRES_DB=neuralchain_db
DATABASE_URL=postgresql://neuralchain:neuralchain_secret@postgres:5432/neuralchain_db

REDIS_URL=redis://redis:6379/0

NEO4J_AUTH=neo4j/neuralchain_neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neuralchain_neo4j

SECRET_KEY=change_me_in_production
DEBUG=true

GEOIP_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb

# Database
POSTGRES_URL=postgresql://sih_user:sih_pass@postgres:5432/sih26146
