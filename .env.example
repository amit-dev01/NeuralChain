# Environment Variables — Copy to .env and fill in values
POSTGRES_USER=neuralchain
POSTGRES_PASSWORD=neuralchain_secret
POSTGRES_DB=neuralchain_db
DATABASE_URL=postgresql://neuralchain:neuralchain_secret@postgres:5432/neuralchain_db

REDIS_URL=redis://redis:6379/0

NEO4J_AUTH=neo4j/neuralchain_neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neuralchain_neo4j

SECRET_KEY=change_me_in_production
DEBUG=true

GEOIP_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb

# Database
POSTGRES_URL=postgresql://sih_user:sih_pass@postgres:5432/sih26146
DATABASE_URL=postgresql://sih_user:sih_pass@postgres:5432/sih26146

# GeoIP
MAXMIND_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb
GEOIP_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Google GenAI / Gemini API (Gemma 4 & Gemini)
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
